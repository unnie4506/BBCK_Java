<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">
    <display-name>Quan Ly Homestay</display-name>

    <filter>
        <filter-name>MaHoaKyTuFilter</filter-name>
        <filter-class>vn.edu.quanlyhomestay.filter.MaHoaKyTuFilter</filter-class>
    </filter>
    <filter>
        <filter-name>QuanLyFilter</filter-name>
        <filter-class>vn.edu.quanlyhomestay.filter.QuanLyFilter</filter-class>
    </filter>
    <filter>
        <filter-name>KhachHangFilter</filter-name>
        <filter-class>vn.edu.quanlyhomestay.filter.KhachHangFilter</filter-class>
    </filter>

    <filter-mapping>
        <filter-name>MaHoaKyTuFilter</filter-name>
        <url-pattern>/api/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>QuanLyFilter</filter-name>
        <url-pattern>/api/quan-ly/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>KhachHangFilter</filter-name>
        <url-pattern>/api/khach-hang/*</url-pattern>
    </filter-mapping>

    <servlet>
        <servlet-name>QuanLyXacThucServlet</servlet-name>
        <servlet-class>vn.edu.quanlyhomestay.controller.quanly.QuanLyXacThucServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>KhachHangXacThucServlet</servlet-name>
        <servlet-class>vn.edu.quanlyhomestay.controller.khachhang.KhachHangXacThucServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>XuLyLoiApiServlet</servlet-name>
        <servlet-class>vn.edu.quanlyhomestay.controller.congkhai.XuLyLoiApiServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>QuanLyXacThucServlet</servlet-name>
        <url-pattern>/api/quan-ly/xac-thuc/dang-nhap</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>QuanLyXacThucServlet</servlet-name>
        <url-pattern>/api/quan-ly/xac-thuc/dang-xuat</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>QuanLyXacThucServlet</servlet-name>
        <url-pattern>/api/quan-ly/xac-thuc/ho-so</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>KhachHangXacThucServlet</servlet-name>
        <url-pattern>/api/khach-hang/xac-thuc/dang-xuat</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>KhachHangXacThucServlet</servlet-name>
        <url-pattern>/api/khach-hang/xac-thuc/ho-so</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>KhachHangXacThucServlet</servlet-name>
        <url-pattern>/api/cong-khai/xac-thuc/dang-ky</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>KhachHangXacThucServlet</servlet-name>
        <url-pattern>/api/cong-khai/xac-thuc/dang-nhap</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>XuLyLoiApiServlet</servlet-name>
        <url-pattern>/api-error</url-pattern>
    </servlet-mapping>

    <session-config>
        <session-timeout>60</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
            <!-- Secure theo HTTPS do Tomcat nhận; chỉ ép secure=true trong môi trường HTTPS-only. -->
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

    <error-page>
        <error-code>404</error-code>
        <location>/api-error</location>
    </error-page>
    <error-page>
        <error-code>405</error-code>
        <location>/api-error</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/api-error</location>
    </error-page>
</web-app>

