# Đường dẫn giao diện quản lý: chỉ là một đoạn ngắn, không gồm context Tomcat.
# Ví dụ: /qlv-a83f19c2; thay bằng chuỗi ngẫu nhiên riêng của bạn.
VITE_DUONG_DAN_QUAN_LY=/qlv-thay-bang-chuoi-ngau-nhien

# Dia chi Tomcat bao gom context path cua WAR.
VITE_DIA_CHI_TOMCAT=http://localhost:8080/quan-ly-homestay-may-chu

# Khi build de deploy cung Tomcat, API nam cung origin va context WAR.
VITE_DUONG_DAN_API=/quan-ly-homestay-may-chu/api

# Dev mở tại http://localhost:5173/<đường-dẫn-quản-lý>/#/dang-nhap.
# Khi triển khai, Tomcat tự thêm context ứng dụng trước đường dẫn này.

